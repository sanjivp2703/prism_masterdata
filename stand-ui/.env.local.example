# Copy this file to .env.local and fill in your values.
#
# Only the "Required" block is needed to boot. Warehouse credentials and the
# AI key are normally entered through the in-app /setup wizard (stored
# encrypted in the app database); the env entries for them below are a
# fallback, used only when nothing has been saved through the wizard.
# Full reference: the "Environment Variables" table in ../CLAUDE.md.

# ── Required ─────────────────────────────────────────────────────────────────
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# 64 hex chars (32 bytes). Encrypts stored credentials (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Keep it in a password manager — losing it orphans every stored secret.
PRISM_ENCRYPTION_KEY=
# The bootstrap admin's Google email. Every other user must be invited.
ADMIN_EMAIL=you@example.com

# ── Google OAuth (login + Google Sheets pipelines) ───────────────────────────
# In Google Cloud Console: enable the Sheets and Drive APIs, create an OAuth 2.0
# "Web application" client, and add the redirect URI below to it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Warehouse choice (fallback — the wizard's choice wins) ───────────────────
# snowflake (default) | mssql | postgres | mysql
PRISM_WAREHOUSE_TYPE=

# ── Snowflake service connection (fallback) ──────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# PRISM_WH is the dedicated warehouse created by 01_internal_tables.sql
# (XSMALL, 60 s auto-suspend).
SNOWFLAKE_WAREHOUSE=PRISM_WH
# Authenticate with ONE of: key pair (preferred) or password.
# SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_PASSWORD=

# ── SQL Server service connection (fallback) ─────────────────────────────────
# MSSQL_SERVER=localhost
# MSSQL_PORT=1433
# MSSQL_DATABASE=PRISM_DB
# MSSQL_USER=
# MSSQL_PASSWORD=
# MSSQL_ENCRYPT=true
# MSSQL_TRUST_SERVER_CERT=true   # dev container's self-signed certificate only

# ── PostgreSQL service connection (fallback) ─────────────────────────────────
# PG_DATABASE is the ONE database this installation standardizes.
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=
# PG_USER=
# PG_PASSWORD=
# PG_SSLMODE=disable             # disable | require | verify-full
# PG_SSL_CA_PATH=

# ── MySQL service connection (fallback; MySQL 8.0.19+) ───────────────────────
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_SSL=false                # false | true | strict

# ── AI provider (fallback) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional model overrides.
# PRISM_CHUNK_MODEL=
# PRISM_MERGE_MODEL=
# PRISM_OPENAI_MODEL=
# PRISM_GEMINI_MODEL=

# ── Email invitations (optional) ─────────────────────────────────────────────
APP_URL=http://localhost:8000
# Either an HTTPS email API key...
# RESEND_API_KEY=
# EMAIL_FROM=Prism <noreply@example.com>
# ...or plain SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Prism <noreply@example.com>

# ── Optional services ────────────────────────────────────────────────────────
# Redis enables auto-export baseline tracking; the app degrades gracefully without it.
# REDIS_URL=redis://localhost:6379
# Error monitoring. Completely disabled when unset.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ── Local app database (SQLite) ──────────────────────────────────────────────
# Metadata and configuration only — customer values never rest here.
# Must be on persistent storage; back it up by copying the file.
# Default: ./data/prism.db (relative to stand-ui/)
# PRISM_SQLITE_PATH=

# ── Edition ──────────────────────────────────────────────────────────────────
# standard (default) or native (the Snowflake Native App build). Set both
# together; the native Docker image bakes them in — leave unset for local dev.
# PRISM_EDITION=
# NEXT_PUBLIC_PRISM_EDITION=

# ── Development toggles — never set on a customer installation ───────────────
# PRISM_DEBUG_TOOLS=true          # enables /debug and /api/admin/table
# PRISM_DEBUG_ARTIFACTS=true      # writes LLM breakdown JSONs to the OS temp dir
# NEXT_PUBLIC_PRISM_DEMO_DATA=true  # prefills the connect form with the demo table
# PRISM_FRESH_SETUP=true          # simulates a bare install on setup surfaces
